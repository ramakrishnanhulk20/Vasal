# The agent server's address. Read on the server only, never sent to the browser.
VASAL_API_URL=https://api.vasal.site

# Cloudflare Turnstile site key for vasal.site (public, not a secret); unset locally uses Cloudflare's test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The agent server the browser calls (public).
NEXT_PUBLIC_VASAL_API_URL=https://api.vasal.site
