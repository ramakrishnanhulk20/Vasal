# Copy to .env and fill in. Never commit .env.
# In development only QLOO_API_KEY (and ANTHROPIC_API_KEY for the agent) are
# needed; everything else has a safe local default. In production
# (NODE_ENV=production) the server refuses to start without the ones marked
# "required in production".

# Qloo hackathon key, from the form at https://forms.gle/zz12orkLHTAneLGz6
QLOO_API_KEY=
# Hackathon keys only work on this host
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Whether the agent asks Qloo for trend data, on or off. Qloo's hackathon host
# returned no trend data on 21 Oct 2026; set on only after a probe shows
# trending rows.
VASAL_TRENDS=off

# Anthropic key for the agent's model (console.anthropic.com, API keys)
ANTHROPIC_API_KEY=
# The agent's model and effort. Haiku is the default because it is the
# cheapest model that does the job; switch only if a test shows it cannot.
VASAL_MODEL=claude-haiku-5-5
VASAL_EFFORT=medium
# Daily ceiling on model tokens across the whole site
ANTHROPIC_TOKENS_PER_DAY=2000000

# YouTube Data API v3 key, restricted to that API (console.cloud.google.com).
# Only the backtest uses it.
YOUTUBE_API_KEY=

# Postgres connection string for the vasal_app role (required in production).
# Unset in development means an in-memory PGlite database.
DATABASE_URL=
# The database owner's connection string, used only by the operator scripts
# (npm run ops, npm run backtest) for migrations, budgets and pruning. Never
# give this one to the web or agent server.
OWNER_DATABASE_URL=

# Cloudflare Turnstile secret for the human check on run start (required in
# production; Cloudflare's test secrets are refused there).
TURNSTILE_SECRET_KEY=

# The web app's public origin, used for CORS and the Origin check on every
# POST (required in production, https only).
APP_ORIGIN=http://localhost:3000

# Secret for hashing visitor addresses before they are stored, at least 32
# characters (required in production).
VISITOR_HASH_SECRET=

# The header the host's edge sets to the real client address, which clients
# cannot set themselves, for example fly-client-ip (required in production).
CLIENT_IP_HEADER=

# Port for the agent server
PORT=8787

# Limits
RUNS_PER_VISITOR_PER_DAY=5
MAX_INFLIGHT_RUNS=3
