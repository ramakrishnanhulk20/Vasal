# Copy to .env and fill in. Never commit .env.

# Qloo hackathon key, from the form at https://forms.gle/zz12orkLHTAneLGz6
QLOO_API_KEY=
# Hackathon keys only work on this host
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Anthropic key for the agent's model (console.anthropic.com, API keys)
ANTHROPIC_API_KEY=

# YouTube Data API v3 key, restricted to that API (console.cloud.google.com)
YOUTUBE_API_KEY=

# Postgres connection string (Neon in production)
DATABASE_URL=

# Cloudflare Turnstile secret for the human check on run start
TURNSTILE_SECRET_KEY=

# The web app's public origin, used for the Origin check on every POST
APP_ORIGIN=http://localhost:3000

# Shared secret the web app uses when relaying to the agent server
RELAY_SECRET=

# Secret for hashing visitor addresses before they are stored
VISITOR_HASH_SECRET=
